#!/data/data/com.termux/files/usr/bin/bash
# ==============================================================================
# agy-mobile: Gerenciador do Container Linux e Daemon para o APK Android
# ==============================================================================

set -euo pipefail

GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

VNC_RESOLUTION="${AGY_RESOLUTION:-1920x1080}"
VNC_DISPLAY=":1"
VNC_PORT="5901"
NOVNC_PORT="6080"
TTYD_PORT="7681"

start_cli() {
    echo -e "${CYAN}Iniciando Google Antigravity CLI (agy) no Ubuntu ARM64...${NC}"
    proot-distro login ubuntu --shared-tmp -- bash -ic '
        export PATH="$HOME/.local/bin:$HOME/.antigravity/bin:$PATH"
        if command -v agy >/dev/null 2>&1; then
            agy
        else
            echo "Instalando Antigravity CLI..."
            curl -fsSL https://antigravity.google/cli/install.sh | bash
            export PATH="$HOME/.local/bin:$HOME/.antigravity/bin:$PATH"
            agy
        fi
    '
}

start_ttyd_daemon() {
    echo -e "${CYAN}Iniciando servidor Terminal Web (ttyd) na porta ${TTYD_PORT} para o APK...${NC}"
    pkill -f "ttyd -p ${TTYD_PORT}" >/dev/null 2>&1 || true
    nohup ttyd -p "${TTYD_PORT}" -W bash -c "agy-mobile cli" >/dev/null 2>&1 &
    echo -e "${GREEN}✅ Modo Terminal pronto para o APK em http://127.0.0.1:${TTYD_PORT}${NC}"
}

start_gui_vnc() {
    echo -e "${CYAN}Iniciando Desktop Linux (TigerVNC + noVNC na porta ${NOVNC_PORT})...${NC}"
    proot-distro login ubuntu --shared-tmp -- bash -ic "
        vncserver -kill ${VNC_DISPLAY} >/dev/null 2>&1 || true
        pkill -f 'websockify.*${NOVNC_PORT}' >/dev/null 2>&1 || true
        vncserver ${VNC_DISPLAY} -geometry ${VNC_RESOLUTION} -depth 24 -localhost no -SecurityTypes None
        nohup websockify --web=/usr/share/novnc/ ${NOVNC_PORT} localhost:${VNC_PORT} >/dev/null 2>&1 &
    "
    echo -e "${GREEN}✅ Desktop Linux pronto para o APK em http://127.0.0.1:${NOVNC_PORT}${NC}"
}

start_app_daemon() {
    MODE="${1:-both}"
    termux-wake-lock 2>/dev/null || true
    case "$MODE" in
        cli)  start_ttyd_daemon ;;
        gui)  start_gui_vnc ;;
        both|*)
            start_ttyd_daemon
            start_gui_vnc
            ;;
    esac
}

stop_all() {
    echo -e "${YELLOW}Encerrando daemons do Antigravity Mobile...${NC}"
    pkill -f "ttyd -p ${TTYD_PORT}" >/dev/null 2>&1 || true
    proot-distro login ubuntu --shared-tmp -- bash -ic "
        vncserver -kill ${VNC_DISPLAY} >/dev/null 2>&1 || true
        pkill -f 'websockify.*${NOVNC_PORT}' >/dev/null 2>&1 || true
    "
    termux-wake-unlock 2>/dev/null || true
    echo -e "${GREEN}Serviços encerrados.${NC}"
}

start_shell() {
    echo -e "${CYAN}Abrindo terminal Ubuntu ARM64 (digite 'agy' para iniciar o Antigravity)...${NC}"
    proot-distro login ubuntu --shared-tmp
}

start_x11() {
    echo -e "${CYAN}Iniciando Termux:X11 (Aceleração Nativa no Android)...${NC}"
    termux-x11 :0 -ac &
    sleep 2
    proot-distro login ubuntu --shared-tmp -- bash -ic "export DISPLAY=:0; dbus-launch --exit-with-session startxfce4"
}

update_agy() {
    echo -e "${CYAN}Atualizando Ubuntu e Google Antigravity...${NC}"
    proot-distro login ubuntu --shared-tmp -- bash -ic "
        apt-get update -y && apt-get upgrade -y
        curl -fsSL https://antigravity.google/cli/install.sh | bash
    "
    echo -e "${GREEN}Atualização concluída!${NC}"
}

show_menu() {
    clear
    echo -e "${CYAN}╔════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║         🚀 ANTIGRAVITY MOBILE - PAINEL DE CONTROLE         ║${NC}"
    echo -e "${CYAN}╚════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo "  1) Iniciar Daemons para o APK Android (Terminal + Desktop)"
    echo "  2) Iniciar Antigravity CLI aqui no Terminal (agy)"
    echo "  3) Iniciar Desktop Linux via noVNC/VNC"
    echo "  4) Iniciar Desktop Linux via Termux:X11"
    echo "  5) Parar todos os serviços em background"
    echo "  6) Abrir Terminal Bash no Ubuntu ARM64"
    echo "  7) Atualizar Antigravity & Pacotes do Ubuntu"
    echo "  0) Sair"
    echo ""
    read -rp "Escolha uma opção [0-7]: " opt
    case "$opt" in
        1) start_app_daemon both ;;
        2) start_cli ;;
        3) start_gui_vnc ;;
        4) start_x11 ;;
        5) stop_all ;;
        6) start_shell ;;
        7) update_agy ;;
        0) exit 0 ;;
        *) echo -e "${RED}Opção inválida.${NC}" ;;
    esac
}

case "${1:-menu}" in
    app-daemon) start_app_daemon "${2:-both}" ;;
    cli)        start_cli ;;
    gui)        start_gui_vnc ;;
    x11)        start_x11 ;;
    stop)       stop_all ;;
    shell)      start_shell ;;
    update)     update_agy ;;
    menu|*)     show_menu ;;
esac
