#!/data/data/com.termux/files/usr/bin/bash
# ==============================================================================
# agy-mobile: Gerenciador de execução do Antigravity no Android / Tablet
# ==============================================================================

set -euo pipefail

GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

VNC_RESOLUTION="${AGY_RESOLUTION:-1920x1080}"
VNC_DISPLAY=":1"
VNC_PORT="5901"

start_cli() {
    echo -e "${CYAN}Iniciando Google Antigravity CLI (agy) no Ubuntu ARM64...${NC}"
    proot-distro login ubuntu --shared-tmp -- bash -ic '
        if command -v agy >/dev/null 2>&1; then
            agy
        else
            echo "Instalando Antigravity CLI..."
            curl -fsSL https://antigravity.google/cli/install.sh | bash
            export PATH="$HOME/.local/bin:$HOME/.antigravity/bin:$PATH"
            agy
        fi
    '
}

start_shell() {
    echo -e "${CYAN}Abrindo terminal Ubuntu ARM64 (digite 'agy' para iniciar o Antigravity)...${NC}"
    proot-distro login ubuntu --shared-tmp
}

start_gui_vnc() {
    echo -e "${CYAN}Iniciando servidor gráfico Linux (TigerVNC - Resolução: ${VNC_RESOLUTION})...${NC}"
    echo -e "${YELLOW}Dica: Para tablets use AGY_RESOLUTION=2560x1600 agy-mobile gui${NC}"
    proot-distro login ubuntu --shared-tmp -- bash -ic "
        vncserver -kill ${VNC_DISPLAY} >/dev/null 2>&1 || true
        vncserver ${VNC_DISPLAY} -geometry ${VNC_RESOLUTION} -depth 24 -localhost no
    "
    echo ""
    echo -e "${GREEN}✅ Desktop Linux iniciado com sucesso!${NC}"
    echo -e "Conecte seu app VNC Viewer (AVNC, RealVNC ou bVNC) no endereço:"
    echo -e "  👉 ${CYAN}127.0.0.1:${VNC_PORT}${NC}"
    echo ""
}

stop_gui_vnc() {
    echo -e "${YELLOW}Parando servidor VNC...${NC}"
    proot-distro login ubuntu --shared-tmp -- bash -ic "vncserver -kill ${VNC_DISPLAY} || true"
    echo -e "${GREEN}Servidor gráfico encerrado.${NC}"
}

start_x11() {
    echo -e "${CYAN}Iniciando Termux:X11 (Aceleração Nativa no Android)...${NC}"
    if ! command -v termux-x11 >/dev/null 2>&1; then
        echo -e "${RED}Pacote termux-x11-nightly não encontrado. Instale com: pkg install x11-repo && pkg install termux-x11-nightly${NC}"
        exit 1
    fi
    termux-x11 :0 -ac &
    sleep 2
    proot-distro login ubuntu --shared-tmp -- bash -ic "export DISPLAY=:0; dbus-launch --exit-with-session startxfce4"
}

update_agy() {
    echo -e "${CYAN}Atualizando Ubuntu e Google Antigravity...${NC}"
    proot-distro login ubuntu --shared-tmp -- bash -ic "
        apt-get update -y && apt-get upgrade -y
        curl -fsSL https://antigravity.google/cli/install.sh | bash
    "
    echo -e "${GREEN}Atualização concluída!${NC}"
}

show_menu() {
    clear
    echo -e "${CYAN}╔════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║         🚀 ANTIGRAVITY MOBILE - PAINEL DE CONTROLE         ║${NC}"
    echo -e "${CYAN}╚════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo "  1) Iniciar Antigravity CLI (Terminal Rápido - agy)"
    echo "  2) Iniciar Desktop Linux via VNC (Ideal para Tablet / Mouse)"
    echo "  3) Iniciar Desktop Linux via Termux:X11 (Alta Performance)"
    echo "  4) Parar Desktop Linux (VNC)"
    echo "  5) Abrir Terminal Bash no Ubuntu ARM64"
    echo "  6) Atualizar Antigravity & Pacotes do Ubuntu"
    echo "  0) Sair"
    echo ""
    read -rp "Escolha uma opção [0-6]: " opt
    case "$opt" in
        1) start_cli ;;
        2) start_gui_vnc ;;
        3) start_x11 ;;
        4) stop_gui_vnc ;;
        5) start_shell ;;
        6) update_agy ;;
        0) exit 0 ;;
        *) echo -e "${RED}Opção inválida.${NC}" ;;
    esac
}

case "${1:-menu}" in
    cli)    start_cli ;;
    gui)    start_gui_vnc ;;
    x11)    start_x11 ;;
    stop)   stop_gui_vnc ;;
    shell)  start_shell ;;
    update) update_agy ;;
    menu|*) show_menu ;;
esac
